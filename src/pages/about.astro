---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="About Alain Joss — data science, engineering, research, and teaching." />
    <meta name="theme-color" content="#f1e8d4" />
    <title>Alain Joss — About</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#about">Skip to content</a>
    <div class="shell">
      <header class="masthead">
        <span class="wordmark">alain joss</span>
        <nav aria-label="Main navigation"><a href="/">projects</a><a href="/about" aria-current="page">about</a></nav>
      </header>
      <main>
        <section id="about" class="about about-page" aria-labelledby="about-heading">
          <h1 id="about-heading">about<span class="cursor" aria-hidden="true">_</span></h1>
          <div class="about-grid">
            <div class="about-copy">
              <p>Data scientist based in Zürich. My work spans data pipelines, scientific experiments and simulations, machine learning, and interactive data analysis.</p>
              <p>I’m an engineer at heart. I enjoy moving between disciplines and turning unfamiliar problems into working systems.</p>
            </div>
          </div>
          <dl class="background-summary">
            <div><dt>Education</dt><dd><ul class="background-list"><li class="background-entry">MSc in Data Science<span class="institution">University of Zürich</span></li><li class="background-entry">BSc in Business Administration, minor in Computer Science<span class="institution">University of Bern</span></li></ul></dd></div>
            <div><dt>Research</dt><dd><ul class="background-list"><li class="background-entry">Generative weather modeling (Master’s thesis)<span class="institution">Swiss Data Science Center</span></li><li class="background-entry">Scientific data pipelines<span class="institution">SLF</span></li><li class="background-entry">Ecological networks and simulations<span class="institution">WSL</span></li></ul></dd></div>
            <div><dt>Teaching</dt><dd><ul class="background-list"><li class="background-entry">Teaching assistant for Data Science for Environmental Systems<span class="institution">ETH Zurich</span></li><li class="background-entry">Workshop on reproducible data pipelines<span class="institution">SLF</span></li></ul></dd></div>
          </dl>
          <div class="contact-links"><a href="https://github.com/alainjoss">GitHub ↗</a><a href="https://linkedin.com/in/alainjoss">LinkedIn ↗</a><a href="mailto:alain.joss.1998@gmail.com">Email ↗</a></div>
        </section>
      </main>
    </div>
  </body>
</html>
