---
import { projects, forecasting } from '../data/projects';
import '../styles/global.css';
const entries = forecasting ? [...projects, forecasting] : projects;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Alain Joss — selected projects, research, and tools across disciplines." />
    <meta name="theme-color" content="#f7f4ec" />
    <title>Alain Joss — Projects</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#projects">Skip to projects</a>
    <div class="shell">
      <header class="masthead">
        <span class="wordmark">alain joss</span>
        <nav aria-label="Main navigation"><a href="/" aria-current="page">projects</a><a href="/about">about</a></nav>
      </header>
      <main>
        <section class="intro" aria-labelledby="heading">
          <h1 id="heading">projects<span class="cursor" aria-hidden="true">_</span></h1>
          <p class="intro-copy">A few things I’ve built or contributed to.</p>
        </section>
        <section id="projects" aria-label="Projects">
          <div class="project-grid">
            {entries.map((project) => (
              <a class="project-card" href={project.href}>
                <h2>{project.title}</h2>
                <p class="project-summary">{project.description}</p>
                <p class="project-detail">{project.detail}</p>
                <ul class="tags" aria-label="Topics">{project.tags.map(tag => <li>{tag}</li>)}</ul>
                <div class="card-link">{project.linkLabel}<span aria-hidden="true">↗</span></div>
              </a>
            ))}
          </div>
        </section>

      </main>
      <footer><a href="/about">about →</a></footer>
    </div>
  </body>
</html>
