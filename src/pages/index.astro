---
import { projects, forecasting } from '../data/projects';
import '../styles/global.css';
const entries = forecasting ? [...projects, forecasting] : projects;
const sections = ['research', 'products'] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Alain Joss — selected projects, research, and tools across disciplines." />
    <meta name="theme-color" content="#eadbbc" />
    <title>Alain Joss — Projects</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#projects">Skip to projects</a>
    <div class="shell">
      <header class="masthead">
        <span class="wordmark">alain joss</span>
        <nav aria-label="Main navigation"><a href="/" aria-current="page">projects</a><a href="/about">about</a></nav>
      </header>
      <main>
        <section class="intro" aria-labelledby="heading">
          <h1 id="heading">projects<span class="cursor" aria-hidden="true">_</span></h1>
          <p class="intro-copy">Selected projects I’ve built or contributed&nbsp;to.</p>
        </section>
        <section id="projects" aria-label="Projects">
          {sections.map(section => (
          <section class="project-section" aria-labelledby={`${section}-heading`}>
            <h2 class="project-section-title" id={`${section}-heading`}>{section}/</h2>
          <div class="project-grid">
            {entries.filter(project => project.section === section).map((project) => {
              const Card = project.href ? 'a' : 'article';
              return (
              <Card class="project-card" href={project.href}>
                <h3>{project.title}</h3>
                <p class="project-summary">{project.description}</p>
                {project.detail && <p class="project-detail">{project.detail}</p>}
                <ul class="tags" aria-label="Topics">{project.tags.map(tag => <li>{tag}</li>)}</ul>
                <div class="card-link">{project.linkLabel}{project.href && <span aria-hidden="true">↗</span>}</div>
              </Card>
              );
            })}
          </div>
          </section>
          ))}
        </section>

      </main>
    </div>
  </body>
</html>
